# ClearML Server
CLEARML_SERVER_IMAGE=clearml/server:2.4.0
CLEARML_WEB_PORT=8080
CLEARML_API_PORT=8008
CLEARML_FILES_PORT=8081

# 学習Queueとclearml-agent
CLEARML_TRAINING_QUEUE=semiconductor-training
CLEARML_PIPELINE_QUEUE=semiconductor-pipeline
TRAINING_AGENT_IMAGE=stackup/semiconductor-agent:0.1.0
# ローカルビルドのイメージにはregistry digestがない。来歴を残すには
# `docker image inspect --format '{{.Id}}' <image>` の値を入れる。
TRAINING_AGENT_IMAGE_DIGEST=unknown
# Agentの名前。両Agentは同じホスト名・同じPIDで動くため、既定値のままだと
# ClearML上でworker idが衝突し、片方のQueueが無人に見える。
CLEARML_TRAINING_WORKER_NAME=semiconductor-training-agent
CLEARML_PIPELINE_WORKER_NAME=semiconductor-pipeline-agent

# 待ち受けるアドレス
#
# 監視も推論もホストのネットワークをそのまま使う。0.0.0.0 にすると、
# 同じLANの誰でも推論を呼び、Queueの状態とホストの資源を読める。
# 既定はループバックで、外へ出すのは前段（reverse proxy・ingress）の仕事。
BIND_ADDRESS=127.0.0.1

# 認証・認可
#
# 「呼んでよい者」を name:role:fingerprint の形で並べる（区切りは ;）。
# 書くのは fingerprint（トークンのSHA-256）であって、トークンではない。
# この一覧が漏れても、それだけでは誰も呼べない。
#
#   pnpm sec:token -- --name batch-scoring --role predictor
#
# 役割は predictor（予測とモデルの確認）・operator（モデルの確認と数字）・
# scraper（数字だけ）。ローカルでは scripts/security-tokens.sh が
# .generated/security/clients.env を作り、backend:up がそこから渡すため、
# ここは空のままでよい。空のまま起動しようとしたサービスは、開いたまま
# 起動するのではなく、理由を述べて起動を拒否する。
PREDICTION_API_CLIENTS=
OPS_EXPORTER_CLIENTS=

# 推論サービス
PREDICTION_PORT=8090
PREDICTION_API_IMAGE=stackup/semiconductor-prediction-api:0.1.0
PREDICTION_API_IMAGE_DIGEST=unknown
# 障害の再現でのみ使う。通常は空にして、Registryのproductionを提供する。
PREDICTION_MODEL_ID=
# TLS。両方そろって初めて有効になり、片方だけだと起動を拒否する
# （平文で待ち受けているのに暗号化されていると思い込む状態を作らない）。
# ローカルはループバックのみのため空でよい。
PREDICTION_TLS_CERTIFICATE_FILE=
PREDICTION_TLS_PRIVATE_KEY_FILE=

# 観測性
OPS_EXPORTER_PORT=8091
# Task結果を「直近」として数える幅。短くすると失敗に早く気付くが、
# 学習が1件も走らない時間帯に0件が続き、成功率が読めなくなる。
OPS_EXPORTER_RECENT_MINUTES=30
OPS_EXPORTER_IMAGE=stackup/semiconductor-ops-exporter:0.1.0
OPS_EXPORTER_PROJECTS=Semiconductor Quality Prediction
NODE_EXPORTER_PORT=9100
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
