{
  "name": "stackup-web",
  "version": "2.5.0",
  "license": "",
  "engines": {
    "pnpm": "^10"
  },
  "scripts": {
    "ng": "ng",
    "config:credentials": "node scripts/generate-credentials.mjs",
    "start": "pnpm run config:credentials && ng serve --host 0.0.0.0 --port 4200",
    "start-widgets": "ng serve --port 4201 --project report-widgets --proxy-config proxy.config.mjs --live-reload false",
    "hmr": "ng serve --live-reload true",
    "build": "ng build --configuration production --source-map",
    "build-dev": "node ./node_modules/.bin/ng build --extract-css=false",
    "build-widgets": "ng build --project report-widgets --configuration production",
    "fetch": "./scripts/get-remote-build.sh",
    "test": "pnpm test:ci",
    "test:unit": "ng test stackup --watch=false",
    "test:unit:watch": "ng test stackup",
    "test:widgets": "ng test report-widgets --watch=false",
    "test:ci": "pnpm test:unit && pnpm test:widgets",
    "test:mutation:execution": "stryker run stryker.execution.config.json",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json --pretty false",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "verify:test": "pnpm test:ci && pnpm e2e:typecheck && pnpm e2e",
    "bundle-report": "ng build --configuration production --stats-json && pnpm dlx webpack-bundle-analyzer build/stats.json",
    "submodule": "git submodule update --recursive --remote --init"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/material-date-fns-adapter": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/platform-server": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/service-worker": "^22.1.5",
    "@angular/youtube-player": "^22.1.5",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@ctrl/ngx-github-buttons": "^9.0.0",
    "@ctrl/tinycolor": "4.2.0",
