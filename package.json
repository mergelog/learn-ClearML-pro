{
  "name": "stackup",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "verify": "pnpm run verify:python && pnpm run verify:web && pnpm run verify:security",
    "verify:python": "pnpm run py:lint && pnpm run py:typecheck && pnpm run py:coverage",
    "verify:web": "pnpm run web:gates:test && pnpm run ci:parity && pnpm run test:pyramid && pnpm run web:lint:baseline && pnpm run web:boundaries && pnpm run web:contract && pnpm run web:typecheck:strict && pnpm run web:test && pnpm run web:e2e:typecheck && pnpm run web:build && pnpm run web:scan:build",
    "verify:security": "pnpm run sec:scan",
    "ci:parity": "node scripts/ci-parity.mjs check",
    "test:pyramid": "node scripts/test-pyramid.mjs check",
    "test:pyramid:report": "node scripts/test-pyramid.mjs report",
    "test:flaky": "node scripts/flaky.mjs run",
    "backend:up": "scripts/backend-up.sh",
    "backend:down": "docker compose -f infra/clearml/compose.yaml down",
    "backend:logs": "docker compose -f infra/clearml/compose.yaml logs -f",
    "backend:status": "docker compose -f infra/clearml/compose.yaml ps",
    "agent:build": "docker compose -f infra/clearml/compose.yaml build training-agent",
    "agent:up": "scripts/backend-up.sh training-agent",
    "agent:logs": "docker compose -f infra/clearml/compose.yaml logs -f training-agent",
    "backend:data:status": "scripts/clearml-run.sh .venv/bin/python -m tools.clearml_data_status.cli",
    "py:setup": "virtualenv .venv && .venv/bin/python -m pip install -r requirements/training.txt -r requirements/serving.txt -r requirements/optimization.txt -r requirements/dev.txt",
    "py:lock": "pnpm run py:lock:training && pnpm run py:lock:serving && pnpm run py:lock:optimization && pnpm run py:lock:dev",
    "py:lock:training": ".venv/bin/python -m piptools compile --strip-extras --output-file requirements/training.txt requirements/training.in",
    "py:lock:serving": ".venv/bin/python -m piptools compile --strip-extras --output-file requirements/serving.txt requirements/serving.in",
    "py:lock:optimization": ".venv/bin/python -m piptools compile --strip-extras --output-file requirements/optimization.txt requirements/optimization.in",
    "py:lock:dev": ".venv/bin/python -m piptools compile --strip-extras --output-file requirements/dev.txt requirements/dev.in",
    "py:lint": ".venv/bin/python -m ruff check .",
    "py:typecheck": ".venv/bin/python -m mypy",
    "py:test": "pnpm run ml:test && pnpm run services:test && pnpm run tools:test",
    "py:coverage": ".venv/bin/python -m coverage erase && .venv/bin/python -m coverage run -m unittest discover -s ml/tests -t . -p 'test_*.py' && .venv/bin/python -m coverage run --append -m unittest discover -s services/tests -t . -p 'test_*.py' && .venv/bin/python -m coverage run --append -m unittest discover -s tools/tests -t . -p 'test_*.py' && .venv/bin/python -m coverage report",
    "ml:test": ".venv/bin/python -m unittest discover -s ml/tests -t . -p 'test_*.py'",
    "services:test": ".venv/bin/python -m unittest discover -s services/tests -t . -p 'test_*.py'",
    "tools:test": ".venv/bin/python -m unittest discover -s tools/tests -t . -p 'test_*.py'",
    "seed": "scripts/clearml-run.sh .venv/bin/python -m tools.seed_clearml",
    "seed:semiconductor": "scripts/clearml-run.sh .venv/bin/python -m tools.semiconductor_seed.cli",
    "seed:semiconductor:dataset": "scripts/clearml-run.sh .venv/bin/python -m tools.semiconductor_seed.dataset_cli",
    "ml:train": "scripts/clearml-run.sh .venv/bin/python -m ml.semiconductor_quality.cli",
    "ml:pipeline": "scripts/clearml-run.sh .venv/bin/python -m ml.pipeline.cli",
    "ml:model": "scripts/clearml-run.sh .venv/bin/python -m ml.model_lifecycle.cli",
    "ml:experiment": "scripts/clearml-run.sh .venv/bin/python -m ml.experiment.cli",
    "ml:data": "scripts/clearml-run.sh .venv/bin/python -m ml.data_quality.cli",
    "serving:start": "scripts/service-run.sh .venv/bin/python -m services.prediction_api.main",
    "serving:build": "docker compose -f infra/clearml/compose.yaml build prediction-api",
    "serving:up": "scripts/backend-up.sh prediction-api",
    "serving:logs": "docker compose -f infra/clearml/compose.yaml logs -f prediction-api",
    "serving:smoke": "scripts/serving-smoke.sh",
    "serving:load": "scripts/load-test.sh",
    "serving:openapi:update": ".venv/bin/python -m services.prediction_api.contract_cli",
    "ops:start": "scripts/service-run.sh .venv/bin/python -m services.ops_exporter.main",
    "ops:up": "scripts/backend-up.sh ops-exporter prometheus alertmanager grafana",
    "ops:logs": "docker compose -f infra/clearml/compose.yaml logs -f ops-exporter prometheus alertmanager grafana",
    "ops:smoke": "scripts/observability-smoke.sh",
    "sec:tokens": "scripts/security-tokens.sh",
    "sec:token": ".venv/bin/python -m tools.security.cli token",
    "sec:scan": ".venv/bin/python -m tools.security.cli repository",
    "sec:scan:paths": ".venv/bin/python -m tools.security.cli paths",
    "sec:scan:clearml": "scripts/clearml-run.sh .venv/bin/python -m tools.security.cli clearml",
    "sec:sbom": ".venv/bin/python -m tools.supply_chain.cli sbom",
    "sec:audit": ".venv/bin/python -m tools.supply_chain.cli audit",
    "sec:gate": ".venv/bin/python -m tools.supply_chain.cli gate",
    "web:start": "scripts/clearml-run.sh pnpm --dir apps/web start",
    "web:build": "scripts/clearml-run.sh pnpm --dir apps/web build",
    "web:credentials": "scripts/clearml-run.sh pnpm --dir apps/web config:credentials",
    "web:test": "pnpm --dir apps/web test",
    "web:lint": "pnpm --dir apps/web lint",
    "web:lint:baseline": "node scripts/eslint-baseline.mjs check",
    "web:lint:baseline:update": "node scripts/eslint-baseline.mjs update",
    "web:gates:test": "node --test 'scripts/tests/**/*.test.mjs'",
    "web:boundaries": "node scripts/web-boundaries.mjs check",
    "web:boundaries:report": "node scripts/web-boundaries.mjs report",
    "web:boundaries:update": "node scripts/web-boundaries.mjs update",
    "web:contract": "node scripts/pipeline-contract.mjs check",
    "web:typecheck:strict": "node scripts/web-strict.mjs",
    "web:scan:build": ".venv/bin/python -m tools.security.cli paths apps/web/build",
    "web:e2e": "pnpm --dir apps/web e2e",
    "web:e2e:typecheck": "pnpm --dir apps/web e2e:typecheck"
  }
}
