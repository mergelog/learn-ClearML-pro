{
  "openapi": "3.1.0",
  "info": {
    "title": "Semiconductor quality prediction",
    "summary": "Judge whether a product passes, using the model in production.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Health",
        "description": "Answer whether the process is alive, without touching the model.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Ready",
        "description": "Answer whether the process can serve, and with which model.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "401": {
            "description": "No credential was presented, or it belongs to no known caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The caller is known, and was not granted this.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The service has no model to answer with.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "prediction"
        ],
        "summary": "Predict",
        "description": "Judge a batch of products with the model this process serves.",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "401": {
            "description": "No credential was presented, or it belongs to no known caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The caller is known, and was not granted this.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The service has no model to answer with.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Why the service refused."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "service",
          "status"
        ],
        "title": "HealthResponse",
        "description": "Whether the process is alive."
      },
      "Measurement": {
        "properties": {
          "sample_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "title": "Sample Id",
            "description": "Identifies the product. Echoed back so answers can be matched up."
          },
          "equipment_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Equipment Id",
            "description": "Which machine produced it."
          },
          "process_step": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Process Step",
            "description": "Which step of the process it came from."
          },
          "temperature": {
            "type": "number",
            "maximum": 5000.0,
            "minimum": -273.15,
            "title": "Temperature"
          },
          "pressure": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Pressure"
          },
          "process_time": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Process Time"
          },
          "gas_flow": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Gas Flow"
          },
          "sensor_1": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "Sensor 1"
          },
          "sensor_2": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "Sensor 2"
          },
          "inspection_value": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "Inspection Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sample_id",
          "equipment_id",
          "process_step",
          "temperature",
          "pressure",
          "process_time",
          "gas_flow",
          "sensor_1",
          "sensor_2",
          "inspection_value"
        ],
        "title": "Measurement",
        "description": "One product, described by the columns the model was fitted on."
      },
      "ModelDescription": {
        "properties": {
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "dataset_version": {
            "type": "string",
            "title": "Dataset Version"
          },
          "train_task_id": {
            "type": "string",
            "title": "Train Task Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_id",
          "model_version",
          "stage",
          "dataset_id",
          "dataset_version",
          "train_task_id"
        ],
        "title": "ModelDescription",
        "description": "Which model answered."
      },
      "PredictedSample": {
        "properties": {
          "sample_id": {
            "type": "string",
            "title": "Sample Id"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "One of: pass, fail."
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence",
            "description": "How sure the model is, when the algorithm reports it. Absent when it does not."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sample_id",
          "label"
        ],
        "title": "PredictedSample",
        "description": "The answer for one product."
      },
      "PredictionRequest": {
        "properties": {
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/Measurement"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Measurements",
            "description": "Between one and 500 products."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "measurements"
        ],
        "title": "PredictionRequest",
        "description": "A batch of products to judge.\n\nThe batch is bounded so that one call cannot occupy the service for an\nunbounded time. A caller with more rows makes more calls."
      },
      "PredictionResponse": {
        "properties": {
          "model": {
            "$ref": "#/components/schemas/ModelDescription"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/PredictedSample"
            },
            "type": "array",
            "title": "Predictions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model",
          "predictions"
        ],
        "title": "PredictionResponse",
        "description": "The answers, and the model that gave them."
      },
      "ReadinessResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "model": {
            "$ref": "#/components/schemas/ModelDescription"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "service",
          "status",
          "model"
        ],
        "title": "ReadinessResponse",
        "description": "Whether the process can actually answer, and with which model."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
