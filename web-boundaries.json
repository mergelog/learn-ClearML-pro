{
  "featureRoot": "src/app/features",
  "rules": [
    {
      "id": "no-cross-feature-import",
      "kind": "cross-feature",
      "description": "feature は他の feature を直接 import しない（共有するものは src/app/shared へ置く。webapp-common はベンダー由来の凍結領域なので足さない）"
    },
    {
      "id": "generated-api-behind-boundary",
      "kind": "restricted-import",
      "description": "生成された API model / service に触れるのは feature の境界ファイル（api-service / adapter とその spec）だけ",
      "from": [
        "src/app/features/**"
      ],
      "deny": [
        "src/app/business-logic/**"
      ],
      "allow": [
        "src/app/features/**/*-api.service.ts",
        "src/app/features/**/*-api.service.spec.ts",
        "src/app/features/**/*.adapter.ts",
        "src/app/features/**/*.adapter.spec.ts"
      ]
    },
    {
      "id": "no-shared-to-feature-import",
      "kind": "restricted-import",
      "description": "共有層（webapp-common と src/app/shared）は feature に依存しない",
      "from": [
        "src/app/webapp-common/**",
        "src/app/shared/**"
      ],
      "deny": [
        "src/app/features/**"
      ]
    }
  ],
  "knownViolations": {
